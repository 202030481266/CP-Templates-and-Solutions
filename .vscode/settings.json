{
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "files.eol": "\n",
    "files.associations": {
        "*.hpp": "cpp",
        "*.tcc": "cpp"
    },
    "files.exclude": {
        "**/.build": true
    },
    "search.exclude": {
        "**/.build": true,
        "ac-library/document_*/**": true,
        "ac-library/test/**": true
    },
    "python.REPL.enableREPLSmartSend": false,
    "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/cp-stl",
        "${workspaceFolder}/ac-library"
    ],
    "C_Cpp.default.defines": [
        "LOCAL",
        "_GLIBCXX_ASSERTIONS"
    ],
    "C_Cpp.errorSquiggles": "enabled",
    "terminal.integrated.profiles.windows": {
        "CP PowerShell": {
            "path": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "CP PowerShell",
    "terminal.integrated.env.windows": {
        "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
    },
    "debug.saveBeforeStart": "allEditorsInActiveGroup",
    "task.saveBeforeRun": "always"
}
