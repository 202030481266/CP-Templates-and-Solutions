        "-Mode",
        "Debug",
        "-Compiler",
        "${config:C_Cpp.default.compilerPath}",
        "-Standard",
        "${config:C_Cpp.default.cppStandard}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "CP: Test templates",
      "type": "process",
      "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/cp-stl/tools/cp.ps1",
        "-Action",
        "Test",
        "-Compiler",
        "${config:C_Cpp.default.compilerPath}",
        "-Standard",
        "${config:C_Cpp.default.cppStandard}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "CP: Export submission.cpp",
      "type": "process",
      "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": [
