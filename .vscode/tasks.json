        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/cp-stl/tools/cp.ps1",
        "-Action",
        "Doctor",
        "-Compiler",
        "${config:C_Cpp.default.compilerPath}",
        "-Standard",
        "${config:C_Cpp.default.cppStandard}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
