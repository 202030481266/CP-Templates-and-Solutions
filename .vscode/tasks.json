        "-File",
        "${workspaceFolder}/cp-stl/tools/cp.ps1",
        "-Action",
        "Export",
        "-Source",
        "${file}",
        "-Compiler",
        "${config:C_Cpp.default.compilerPath}",
        "-Standard",
        "${config:C_Cpp.default.cppStandard}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "CP: Check environment",
      "type": "process",
      "command": "${env:WINDIR}/System32/WindowsPowerShell/v1.0/powershell.exe",
