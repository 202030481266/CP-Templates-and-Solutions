void bruteforce() {
	int n;
	cin >> n;
	vi cur;
	vi cnt(2 * n);
	int tot = 0;
	auto dfs = [&](auto&& self, int p) -> void {
		if (p == n) {
			++tot;
			vi res = cur;
			printf("%d\n", n);
			for (int v : res) printf("%d ", v);
			printf("\n");
			return;
		}
		for (int i = p - (n - 1); i < p + 1; ++i) {
			if (i == 0 || cnt[-i + n] > 0) continue;
			cur.push_back(i);
			++cnt[i + n];
			self(self, p + 1);
			cur.pop_back();
			--cnt[i + n];
		}
	};
	dfs(dfs, 0);
	printf("Total num : %d\n", tot);
}


bool guess1(const vi& arr) {
	int n = arr.size();
	vi ids(n);
	iota(ids.begin(), ids.end(), 0);
	ranges::sort(ids, [&](int i, int j) { return arr[i] < arr[j]; });

	vl sum(n + 1);
	vec<pair<ll, int>> pos;
	vec<pair<ll, int>> rot;

	for (int i = 1; i <= n; ++i) {
		sum[i] = sum[i - 1] + arr[ids[i - 1]];
	}

	pos.emplace_back(0, 0);
	for (int i = 1; i <= n; ++i) {
		pos.emplace_back(sum[i], i);
	}

	if (sum[n] == 0) {
		cout << n << '\n';
		for (int i = 1; i <= n; ++i) cout << i << ' ';
		cout << '\n';
		return true;
	}

	// sum[r] == sum[l]
	ranges::sort(pos);
	for (int i = 0; i + 1 < n; ++i) {
		if (pos[i].first == pos[i + 1].first) {
			int l = min(pos[i].second, pos[i + 1].second);
			int r = max(pos[i].second, pos[i + 1].second);
			cout << r - l << '\n';
			for (int i = l; i < r; ++i) {
				cout << ids[i] + 1 << ' ';
			}
			cout << '\n';
			return true;
		}
	}

	return false;
}

bool guess2(const vi& arr) {
	int n = arr.size();
	vi ids(n);
	iota(ids.begin(), ids.end(), 0);
	ranges::sort(ids, [&](int i, int j) { return arr[i] < arr[j]; });

	vl sum(n + 1);
	for (int i = 1; i <= n; ++i) {
		sum[i] = sum[i - 1] + arr[ids[i - 1]];
	}

	return false;
}


void solve() {
	int n;
	cin >> n;

	vi arr(n);
	for (int i = 0; i < n; ++i) cin >> arr[i];

	vi have(n * 2, -1);
	for (int i = 0; i < n; ++i) {
		if (arr[i] == 0) {
			cout << 1 << '\n' << i + 1 << '\n';
			return;
		}
		else {
			have[arr[i] + n] = i;
			if (have[-arr[i] + n] != -1) {
				cout << 2 << '\n' << have[arr[i] + n] + 1 << ' ' << have[-arr[i] + n] + 1 << '\n';
				return;
			}
		}
	}

	bool res = guess1(arr);
	if (!res) res = guess2(arr);
	
	if (res) return;

	ranges::sort(arr);
	for (int v : arr) cerr << v << ' ';
	cerr << '\n';

	cout << "Impossible!" << '\n';
}

int main() {
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	int t;
	cin >> t;
	while (t--) solve();
	return 0;
}